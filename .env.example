# Mistral API (free tier) — https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Self-Consistency: how many synthesis samples to draw and majority-vote over
SELF_CONSISTENCY_K=3

# Hard ceiling on estimated tokens spent per agent run (TokenBudget guardrail)
MAX_TOKEN_BUDGET=60000

# Langfuse (optional — leave blank to run with tracing disabled)
# https://cloud.langfuse.com (free tier)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
